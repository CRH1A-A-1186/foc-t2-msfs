# ---- third-party python libs (regenerate per README section 7; ~300 MB, do not commit)
tools/pylib/
tools/pylib313/
tools/wheels313/
__pycache__/
*.pyc

# ---- raw / large reference material (regenerable with tools/*.py, not needed to rebuild)
# satellite strips + per-tile metadata (tools/google_tiles.py / esri_tiles.py)
ref/sat/
# raw chart vectors and page rasters dumped from the CAAC AIP PDF (tools/export_drawings.py);
# ref/derived/chart_enu.json (the calibrated ENU version) IS committed
ref/apron/*.json
ref/apron/*.png
ref/derived/model_on_google.png
ref/derived/overlay_t2_crop.png
ref/airports.csv
ref/runways.csv

# ---- build / render noise
build/*.blend1
build/*.log
out/*.log
out/renders/*.log
out/renders/shot_*.png
out/renders/_warmup.png
out/renders/render_views.jsonl
out/results/

# ---- OS / editor
Thumbs.db
desktop.ini
.vscode/
.idea/
out/renders/heartbeat.jsonl
ref/gtest.jpg

# ---- third-party material that must NOT be redistributed (added before the repo went public)
# watermarked press photos (Fuzhou Evening News / 福州晚报) used only as local visual reference
ref/photos/*.jpg
ref/photos/commons.json
# text layers extracted from the CAAC AIP 2P-1 PDF (chart content; keep local only)
ref/pdf1/
ref/pdf2/
# ---- reference imagery / chart material: MUST NOT be committed (added 2026-11-27)
# satellite imagery, chart renders, per-feature dumps and the calibrated AIP vectors are all
# local-only working material; the repo ships the derived model coordinates instead
ref/derived/*.png
ref/derived/chart_enu.json
ref/derived/feat_*.json